# Ejemplo de archivo .env
# Copiar a .env y completar con valores reales

# ============================================
# JWT Configuration
# ============================================
JWT_SECRET=cambiar-en-produccion-con-valor-seguro-minimo-256-bits-aleatorios

# ============================================
# Mail Configuration (para recuperación de contraseña)
# ============================================
# Usando Gmail:
# 1. Habilitar autenticación de dos factores en tu cuenta de Google
# 2. Generar una "contraseña de aplicación" en: https://myaccount.google.com/apppasswords
MAIL_USERNAME=tu-email@gmail.com
MAIL_PASSWORD=tu-contraseña-app-generada

# ============================================
# Database Configuration (si no usas Docker)
# ============================================
# DB_URL=jdbc:postgresql://localhost:5432/empresa_cs
# DB_USERNAME=postgres
# DB_PASSWORD=postgres

# ============================================
# Server Configuration
# ============================================
# SERVER_PORT=8080
# SPRING_PROFILE=dev

# ============================================
# Logging
# ============================================
# LOG_LEVEL=DEBUG
# LOG_LEVEL_SPRING=INFO
